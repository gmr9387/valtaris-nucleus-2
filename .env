# Dev-only auto-login (src/lib/auth-context.tsx). Set both to skip the
# /login form in local dev -- gated on import.meta.env.DEV. Requires a
# real Supabase Auth user to already exist in THIS project first
# (Authentication > Users > Add user).
VITE_DEV_AUTO_LOGIN_EMAIL=""
VITE_DEV_AUTO_LOGIN_PASSWORD=""


# ============================================================
# NUCLEUS RUNTIME CONFIGURATION
# ============================================================

